{
  "name": "mepcli",
  "version": "2.0.0-rc.2",
  "description": "Zero-dependency interactive CLI prompt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeTease/mep.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "bun check",
    "compile": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "types": "tsc --emitDeclarationOnly --outDir dist",
    "build": "bun run compile && bun run types",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "demo": "bun example.ts",
    "lint": "bun lint --no-script src",
    "lint:fix": "bun lint --no-script --fix src",
    "fmt": "bun fmt --no-script src",
    "fmt:check": "bun fmt --no-script --check src"
  },
  "keywords": [
    "cli",
    "prompt",
    "prompts",
    "inquirer",
    "enquirer",
    "interactive",
    "interact",
    "zero-dependency",
    "codetease",
    "command-line",
    "typescript",
    "color",
    "ansi",
    "ui",
    "terminal",
    "command-line",
    "mep",
    "mepcli"
  ],
  "author": "CodeTease",
  "license": "MIT",
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
